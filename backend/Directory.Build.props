<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Rules switched off are style/perf rules that add noise without value at this size of codebase. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA2007;CA1062;CA1711;CA1716;CA1031;CA1724;CA1707;CA1861;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1863;CA1056;CA1054;CA1819;CA2227;CA1002;CA5394;CA1859</NoWarn>
  </PropertyGroup>
</Project>
