{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClinicSpace": ""
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "SessionIdleTimeoutMinutes": 30
  },
  "Security": {
    "RequireSecureCookies": true,
    "AbsoluteSessionHours": 8,
    "SignInRequestsPerMinute": 10,
    "ApiRequestsPerMinute": 300,
    "TrustForwardedHeaders": false
  },
  "Requests": {
    "TermsVersion": "2026-11-v1",
    "MinimumDurationMinutes": 30,
    "MaximumDurationDays": 31,
    "MaximumDaysInAdvance": 365,
    "AllowedBudgetHolderEmailDomains": []
  },
  "Notifications": {
    "PublicBaseUrl": "http://localhost:8080",
    "ServiceName": "MPFT Clinic Space",
    "SendSubmissionConfirmation": true
  },
  "Email": {
    "Mode": "Log",
    "FromAddress": "no-reply@clinicspace.test",
    "FromName": "MPFT Clinic Space",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpSecurity": "Auto",
    "FileDirectory": "mail-drop",
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 8
  },
  "Seed": {
    "ApplyMigrations": false,
    "ImportLocations": false,
    "LocationsFile": "data/exercise-data.xlsx",
    "ImportUsers": false,
    "UsersFile": "data/exercise-data.xlsx",
    "CreateDemoData": false
  }
}
